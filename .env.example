# Bbox administration password.
BBOX_PASSWORD=mypassword

# Bbox API base URL.
BBOX_URL=https://mabbox.bytel.fr

# Optional curl --resolve equivalent. In Docker Compose this is also used for extra_hosts.
BBOX_RESOLVE_ADDRESS=192.168.1.254

# Optional curl -k equivalent when using an HTTPS BBOX_URL with a self-signed or invalid TLS certificate.
BBOX_TLS_INSECURE=true

# Address to listen on for telemetry.
TELEMETRY_ADDRESS=0.0.0.0:9100

# Path under which to expose Prometheus metrics.
METRICS_PATH=/metrics

# Maximum time to wait for one Bbox scrape, in milliseconds.
BBOX_SCRAPE_TIMEOUT_MS=30000
